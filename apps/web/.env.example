# LiveKit Cloud project (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GitHub repo whose Releases host the Windows installer (owner/name)
GITHUB_REPO=DBZRoxxx/share

# KLIPY GIF API key (https://partner.klipy.com/api-keys) — powers GIFs in the chat
KLIPY_API_KEY=
