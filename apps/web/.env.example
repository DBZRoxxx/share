# LiveKit Cloud project (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GitHub repo whose Releases host the Windows installer (owner/name)
GITHUB_REPO=DBZRoxxx/share

# KLIPY GIF API key (https://partner.klipy.com/api-keys) — powers GIFs in the chat
KLIPY_API_KEY=

# YouTube Data API v3 key (Google Cloud console → APIs & Services → Credentials).
# Reads titles and playlists for music and the watch party; 10 000 free units a day.
YOUTUBE_API_KEY=

# Chat storage, created from the Vercel dashboard/CLI (both in São Paulo):
#   Upstash for Redis (Marketplace, region gru1/sa-east-1) → KV_REST_API_URL, KV_REST_API_TOKEN
#   Blob store, private, region gru1                     → BLOB_READ_WRITE_TOKEN
# Without them the chat still works live, just without history or attachments.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
